<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.tradeharness.evolution</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/python3</string>
      <string>-m</string>
      <string>tradeharness.evolution.scheduler</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/atif/Public/TradeHarness</string>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>1</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/atif/Public/TradeHarness/var/evolution/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/atif/Public/TradeHarness/var/evolution/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
